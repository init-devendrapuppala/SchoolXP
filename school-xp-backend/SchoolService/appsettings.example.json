{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SchoolDb": "Host=localhost;Port=5432;Database=SchoolDb;Username=<school-db-user>;Password=<school-db-password>"
  },
  "CognitoJwtConfig": {
    "Issuer": "https://cognito-idp.<region>.amazonaws.com/<user-pool-id>",
    "Audience": "<cognito-app-client-id>"
  },
  "DataProtection": {
    "KeysPath": "<persistent-protected-key-store-path>"
  }
}
