{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "IdentityDb": "Host=localhost;Port=5432;Database=IdentityDb;Username=<identity-db-user>;Password=<identity-db-password>"
  },
  "CognitoJwtConfig": {
    "Issuer": "https://cognito-idp.<region>.amazonaws.com/<user-pool-id>",
    "Audience": "<cognito-app-client-id>"
  }
}
